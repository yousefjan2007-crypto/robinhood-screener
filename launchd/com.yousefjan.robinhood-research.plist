<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.yousefjan.robinhood-research</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/yousefjan/robinhood_screener/selfimprove/research/run_research.sh</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/yousefjan/robinhood_screener</string>
    <!-- Sunday 12:00 local, after robinhood-improve (11:00). A headless `claude -p` session
         (Max subscription) proposes at most two NEW candidate bands/policies as code, entirely
         inside a detached temporary worktree; they merge only if verify.py is green and the diff
         stays inside the allowlist, and they enter the candidate pool — never the champion. Ends
         with the ONE weekly summary to Telegram (sent even when research is skipped or paused).
         The autobuild-am/pm jobs at 07:00/21:00 share the Max session budget; --max-turns caps
         this session. Exits 0 always. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key><integer>0</integer>
        <key>Hour</key><integer>12</integer>
        <key>Minute</key><integer>0</integer>
    </dict>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>/Users/yousefjan/robinhood_screener/research.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/yousefjan/robinhood_screener/research.err.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/yousefjan/.npm-global/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
